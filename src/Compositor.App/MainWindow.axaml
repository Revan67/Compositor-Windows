<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:canvas="using:Compositor.App.Canvas"
        xmlns:panels="using:Compositor.App.Panels"
        xmlns:vm="using:Compositor.App.ViewModels"
        x:Class="Compositor.App.MainWindow"
        x:Name="Root"
        x:DataType="vm:EditorViewModel"
        Title="{Binding Title}"
        Width="1024" Height="700" MinWidth="760" MinHeight="520"
        Background="{StaticResource ChromeBrush}">
  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+N" Command="{Binding #Root.NewCanvasCommand}" />
    <KeyBinding Gesture="Ctrl+O" Command="{Binding #Root.OpenCommand}" />
    <KeyBinding Gesture="Ctrl+S" Command="{Binding #Root.SaveCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding #Root.SaveAsCommand}" />
    <KeyBinding Gesture="Ctrl+Z" Command="{Binding Undo}" />
    <KeyBinding Gesture="Ctrl+Shift+Z" Command="{Binding Redo}" />
    <KeyBinding Gesture="Ctrl+Y" Command="{Binding Redo}" />
    <KeyBinding Gesture="Ctrl+Shift+N" Command="{Binding AddLayer}" />
    <KeyBinding Gesture="Ctrl+J" Command="{Binding DuplicateLayer}" />
    <KeyBinding Gesture="Ctrl+G" Command="{Binding GroupLayers}" />
    <KeyBinding Gesture="Ctrl+OemCloseBrackets" Command="{Binding MoveLayerUp}" />
    <KeyBinding Gesture="Ctrl+OemOpenBrackets" Command="{Binding MoveLayerDown}" />
    <KeyBinding Gesture="Ctrl+OemPlus" Command="{Binding ZoomIn}" />
    <KeyBinding Gesture="Ctrl+OemMinus" Command="{Binding ZoomOut}" />
    <KeyBinding Gesture="Ctrl+0" Command="{Binding FitToWindow}" />
    <KeyBinding Gesture="Ctrl+1" Command="{Binding ActualSize}" />
    <KeyBinding Gesture="Ctrl+A" Command="{Binding SelectAll}" />
    <KeyBinding Gesture="Ctrl+D" Command="{Binding Deselect}" />
  </Window.KeyBindings>

  <DockPanel>
    <Menu DockPanel.Dock="Top" Background="{StaticResource ChromeBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1">
      <MenuItem Header="_File">
        <MenuItem Header="New Canvas…" InputGesture="Ctrl+N" Command="{Binding #Root.NewCanvasCommand}" />
        <MenuItem Header="Open Project…" InputGesture="Ctrl+O" Command="{Binding #Root.OpenCommand}" />
        <Separator />
        <MenuItem Header="Save" InputGesture="Ctrl+S" Command="{Binding #Root.SaveCommand}" IsEnabled="{Binding HasDocument}" />
        <MenuItem Header="Save As…" InputGesture="Ctrl+Shift+S" Command="{Binding #Root.SaveAsCommand}" IsEnabled="{Binding HasDocument}" />
        <Separator />
        <MenuItem Header="Import Images…" Command="{Binding #Root.ImportCommand}" IsEnabled="{Binding HasDocument}" />
        <MenuItem Header="Export PNG…" Command="{Binding #Root.ExportPngCommand}" IsEnabled="{Binding HasDocument}" />
        <MenuItem Header="Export JPEG…" Command="{Binding #Root.ExportJpegCommand}" IsEnabled="{Binding HasDocument}" />
        <Separator />
        <MenuItem Header="E_xit" Command="{Binding #Root.ExitCommand}" />
      </MenuItem>
      <MenuItem Header="_Edit">
        <MenuItem Header="{Binding UndoLabel}" InputGesture="Ctrl+Z" Command="{Binding Undo}" />
        <MenuItem Header="{Binding RedoLabel}" InputGesture="Ctrl+Shift+Z" Command="{Binding Redo}" />
      </MenuItem>
      <MenuItem Header="_Image">
        <MenuItem Header="Canvas Size…" Command="{Binding #Root.CanvasSizeCommand}" />
        <MenuItem Header="Image Size…" Command="{Binding #Root.ImageSizeCommand}" />
      </MenuItem>
      <MenuItem Header="_Layer">
        <MenuItem Header="New Layer" InputGesture="Ctrl+Shift+N" Command="{Binding AddLayer}" />
        <MenuItem Header="New Folder" Command="{Binding AddFolder}" />
        <MenuItem Header="Duplicate Layer" InputGesture="Ctrl+J" Command="{Binding DuplicateLayer}" />
        <MenuItem Header="Delete Layer" Command="{Binding DeleteLayer}" />
        <Separator />
        <MenuItem Header="Group Layers" InputGesture="Ctrl+G" Command="{Binding GroupLayers}" />
        <MenuItem Header="Move Layer Up" InputGesture="Ctrl+OemCloseBrackets" Command="{Binding MoveLayerUp}" />
        <MenuItem Header="Move Layer Down" InputGesture="Ctrl+OemOpenBrackets" Command="{Binding MoveLayerDown}" />
        <Separator />
        <MenuItem Header="Add Layer Mask" Command="{Binding AddMask}" />
        <MenuItem Header="Enable / Disable Layer Mask" Command="{Binding ToggleMask}" />
        <MenuItem Header="Delete Layer Mask" Command="{Binding DeleteMask}" />
        <MenuItem Header="Create / Release Clipping Mask" Command="{Binding ToggleClipping}" />
      </MenuItem>
      <MenuItem Header="_Select">
        <MenuItem Header="Select All" InputGesture="Ctrl+A" Command="{Binding SelectAll}" />
        <MenuItem Header="Deselect" InputGesture="Ctrl+D" Command="{Binding Deselect}" />
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem Header="Zoom In" InputGesture="Ctrl+OemPlus" Command="{Binding ZoomIn}" />
        <MenuItem Header="Zoom Out" InputGesture="Ctrl+OemMinus" Command="{Binding ZoomOut}" />
        <MenuItem Header="Fit to Window" InputGesture="Ctrl+0" Command="{Binding FitToWindow}" />
        <MenuItem Header="Actual Pixels" InputGesture="Ctrl+1" Command="{Binding ActualSize}" />
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem Header="Check for Updates…" Command="{Binding #Root.CheckForUpdatesCommand}" />
        <Separator />
        <MenuItem Header="Open Diagnostic Logs" Command="{Binding #Root.OpenLogsCommand}" />
      </MenuItem>
    </Menu>

    <Border DockPanel.Dock="Bottom" Background="{StaticResource ChromeBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" Height="26">
      <DockPanel Margin="10,0">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Spacing="4">
          <Button Command="{Binding ZoomOut}" Content="−" ToolTip.Tip="Zoom Out (Ctrl+-)" Width="22" Height="20" MinHeight="20" Padding="0" Background="Transparent" />
          <TextBlock Text="{Binding ZoomPercent}" Foreground="{StaticResource SecondaryTextBrush}" Width="46" TextAlignment="Center" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
          <Button Command="{Binding ZoomIn}" Content="+" ToolTip.Tip="Zoom In (Ctrl++)" Width="22" Height="20" MinHeight="20" Padding="0" Background="Transparent" />
        </StackPanel>
        <TextBlock x:Name="Status" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" VerticalAlignment="Center" />
      </DockPanel>
    </Border>

    <panels:ToolHeader DockPanel.Dock="Top" />
    <panels:ToolRail DockPanel.Dock="Left" />
    <Grid ColumnDefinitions="*,3,288" Background="{StaticResource CanvasSurroundBrush}">
      <canvas:EditorCanvas x:Name="Canvas" Grid.Column="0" />
      <GridSplitter Grid.Column="1" Background="{StaticResource DividerBrush}" ResizeDirection="Columns" />
      <panels:LayersPanel Grid.Column="2" />
    </Grid>
  </DockPanel>
</Window>
