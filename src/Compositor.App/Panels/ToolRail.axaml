<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Compositor.App.ViewModels"
             x:Class="Compositor.App.Panels.ToolRail"
             x:DataType="vm:EditorViewModel">
  <UserControl.Styles>
    <Style Selector="RadioButton.tool">
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="36" />
      <Setter Property="Margin" Value="2" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="Theme" Value="{StaticResource {x:Type ToggleButton}}" />
    </Style>
  </UserControl.Styles>
  <Border Background="#252526" Width="44">
    <StackPanel Margin="2,6">
      <RadioButton Classes="tool" GroupName="tool" Content="✥" ToolTip.Tip="Move / Transform (V)" IsChecked="{Binding Tool, Converter={x:Static vm:Converters.ToolIs}, ConverterParameter={x:Static vm:EditorTool.Move}}" />
      <RadioButton Classes="tool" GroupName="tool" Content="⌗" ToolTip.Tip="Crop (C)" IsChecked="{Binding Tool, Converter={x:Static vm:Converters.ToolIs}, ConverterParameter={x:Static vm:EditorTool.Crop}}" />
      <RadioButton Classes="tool" GroupName="tool" Content="▧" ToolTip.Tip="Rectangular Marquee (M)" IsChecked="{Binding Tool, Converter={x:Static vm:Converters.ToolIs}, ConverterParameter={x:Static vm:EditorTool.Marquee}}" />
      <RadioButton Classes="tool" GroupName="tool" Content="✋" ToolTip.Tip="Hand (H)" IsChecked="{Binding Tool, Converter={x:Static vm:Converters.ToolIs}, ConverterParameter={x:Static vm:EditorTool.Hand}}" />
      <RadioButton Classes="tool" GroupName="tool" Content="🔍" ToolTip.Tip="Zoom (Z) — Alt-click zooms out" IsChecked="{Binding Tool, Converter={x:Static vm:Converters.ToolIs}, ConverterParameter={x:Static vm:EditorTool.Zoom}}" />
    </StackPanel>
  </Border>
</UserControl>
