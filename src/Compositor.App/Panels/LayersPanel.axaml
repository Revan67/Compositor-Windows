<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Compositor.App.ViewModels"
             x:Class="Compositor.App.Panels.LayersPanel"
             x:DataType="vm:EditorViewModel">
  <DockPanel Background="#252526">
    <TextBlock DockPanel.Dock="Top" Text="Layers" Margin="10,8,10,6" FontWeight="SemiBold" Foreground="#CCCCCC" />

    <!-- Appearance of the active layer -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" Margin="8,0,8,6" IsEnabled="{Binding CanEditAppearance}">
      <ComboBox Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" ItemsSource="{Binding BlendModes}" SelectedItem="{Binding ActiveBlendMode}" HorizontalAlignment="Stretch" FontSize="12" Margin="0,0,0,4" />
      <Slider Grid.Row="1" Grid.Column="0" Minimum="0" Maximum="100" Value="{Binding ActiveOpacityPercent}" VerticalAlignment="Center"
              PointerPressed="OpacityPressed" PointerReleased="OpacityReleased" />
      <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ActiveOpacityPercent, StringFormat={}{0:0}%}" Width="40" TextAlignment="Right" VerticalAlignment="Center" Foreground="#CCCCCC" FontSize="12" />
    </Grid>

    <!-- Row actions -->
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="6,4" Spacing="2">
      <Button Command="{Binding AddLayer}" ToolTip.Tip="New Layer (Ctrl+Shift+N)" Content="+" Width="30" />
      <Button Command="{Binding AddFolder}" ToolTip.Tip="New Folder" Content="▣" Width="30" />
      <Button Command="{Binding AddMask}" ToolTip.Tip="Add Layer Mask" Content="◐" Width="30" />
      <Button Command="{Binding DuplicateLayer}" ToolTip.Tip="Duplicate Layer (Ctrl+J)" Content="⧉" Width="30" />
      <Button Command="{Binding DeleteLayer}" ToolTip.Tip="Delete Layer" Content="🗑" Width="30" />
    </StackPanel>

    <ListBox x:Name="List" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" Background="Transparent" BorderThickness="0"
             SelectionMode="Single" DoubleTapped="RowDoubleTapped">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:LayerRowViewModel">
          <Grid ColumnDefinitions="24,Auto,44,*" Height="44" Opacity="{Binding RowOpacity}" Margin="0">
            <Button Grid.Column="0" Click="EyeClicked" Width="22" Height="22" Padding="0" Background="Transparent" BorderThickness="0" ToolTip.Tip="Visibility" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
              <TextBlock Text="👁" FontSize="12" Opacity="{Binding IsVisible, Converter={x:Static vm:Converters.VisibleToOpacity}}" />
            </Button>
            <Border Grid.Column="1" Width="{Binding Indent}" />
            <Border Grid.Column="2" Width="40" Height="40" Background="#3A3A3A" CornerRadius="2" Margin="2,0" HorizontalAlignment="Left">
              <Panel>
                <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                <TextBlock Text="▣" IsVisible="{Binding IsGroup}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18" Foreground="#AAAAAA" />
              </Panel>
            </Border>
            <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="6,0,4,0">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="↳" IsVisible="{Binding IsClipped}" Foreground="#8AB4F8" FontSize="12" />
                <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="◐" IsVisible="{Binding HasMask}" Foreground="#AAAAAA" FontSize="11" ToolTip.Tip="Has a mask" />
              </StackPanel>
              <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="#9A9A9A" />
            </StackPanel>
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
      <ListBox.ContextMenu>
        <ContextMenu>
          <MenuItem Header="Rename…" Click="RenameClicked" />
          <MenuItem Header="Duplicate Layer" Command="{Binding DuplicateLayer}" />
          <MenuItem Header="Delete Layer" Command="{Binding DeleteLayer}" />
          <Separator />
          <MenuItem Header="Group Layers" Command="{Binding GroupLayers}" />
          <MenuItem Header="Create / Release Clipping Mask" Command="{Binding ToggleClipping}" />
          <Separator />
          <MenuItem Header="Add Layer Mask" Command="{Binding AddMask}" />
          <MenuItem Header="Enable / Disable Mask" Command="{Binding ToggleMask}" />
          <MenuItem Header="Delete Mask" Command="{Binding DeleteMask}" />
        </ContextMenu>
      </ListBox.ContextMenu>
    </ListBox>
  </DockPanel>
</UserControl>
