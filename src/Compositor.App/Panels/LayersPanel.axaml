<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Compositor.App.ViewModels"
             x:Class="Compositor.App.Panels.LayersPanel"
             x:DataType="vm:EditorViewModel">
  <UserControl.Styles>
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="5,1" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="ListBoxItem:selected">
      <Setter Property="Background" Value="{StaticResource AccentMutedBrush}" />
    </Style>
    <Style Selector="Button.layerAction">
      <Setter Property="Width" Value="31" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="FontSize" Value="14" />
    </Style>
  </UserControl.Styles>
  <DockPanel Background="{StaticResource PanelBrush}">
    <Border DockPanel.Dock="Top" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1">
      <TextBlock Text="LAYERS" Margin="12,10,10,8" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" LetterSpacing="1.2" />
    </Border>

    <!-- Appearance of the active layer -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" Margin="8,0,8,6" IsEnabled="{Binding CanEditAppearance}">
      <ComboBox Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" ItemsSource="{Binding BlendModes}" SelectedItem="{Binding ActiveBlendMode}" HorizontalAlignment="Stretch" FontSize="12" Margin="0,0,0,4" />
      <Slider Grid.Row="1" Grid.Column="0" Minimum="0" Maximum="100" Value="{Binding ActiveOpacityPercent}" VerticalAlignment="Center"
              PointerPressed="OpacityPressed" PointerReleased="OpacityReleased" />
      <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ActiveOpacityPercent, StringFormat={}{0:0}%}" Width="40" TextAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource PrimaryTextBrush}" FontSize="12" />
    </Grid>

    <!-- Row actions -->
    <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" Padding="5,4">
      <StackPanel Orientation="Horizontal" Spacing="2">
        <Button Classes="layerAction" Command="{Binding AddLayer}" ToolTip.Tip="New Layer (Ctrl+Shift+N)" Content="+" />
        <Button Classes="layerAction" Command="{Binding AddFolder}" ToolTip.Tip="New Folder" Content="▣" />
        <Button Classes="layerAction" Command="{Binding AddMask}" ToolTip.Tip="Add Layer Mask" Content="◐" />
        <Button Classes="layerAction" Command="{Binding DuplicateLayer}" ToolTip.Tip="Duplicate Layer (Ctrl+J)" Content="⧉" />
        <Button Classes="layerAction" Command="{Binding MoveLayerUp}" ToolTip.Tip="Move selected layer up" Content="↑" />
        <Button Classes="layerAction" Command="{Binding MoveLayerDown}" ToolTip.Tip="Move selected layer down" Content="↓" />
        <Button Classes="layerAction" Command="{Binding DeleteLayer}" ToolTip.Tip="Delete Layer" Content="×" />
      </StackPanel>
    </Border>

    <ListBox x:Name="List" ItemsSource="{Binding Rows}" Background="Transparent" BorderThickness="0"
             SelectionMode="Multiple" SelectionChanged="LayerSelectionChanged" DoubleTapped="RowDoubleTapped">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:LayerRowViewModel">
          <Grid ColumnDefinitions="24,Auto,42,*" Height="48" Opacity="{Binding RowOpacity}" Margin="2,0" Background="Transparent">
            <Button Grid.Column="0" Click="EyeClicked"
                    Width="22" Height="22" Padding="0" Background="Transparent" BorderThickness="0" ToolTip.Tip="Toggle visibility" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
              <TextBlock Text="{Binding VisibilityGlyph}" FontSize="12" />
            </Button>
            <Border Grid.Column="1" Width="{Binding Indent}" />
            <Border Grid.Column="2" Width="38" Height="38" Background="#36373C" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" CornerRadius="3" Margin="2,0" HorizontalAlignment="Left">
              <Panel>
                <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                <TextBlock Text="▣" IsVisible="{Binding IsGroup}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18" Foreground="#AAAAAA" />
              </Panel>
            </Border>
            <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="6,0,4,0">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="↳" IsVisible="{Binding IsClipped}" Foreground="#8AB4F8" FontSize="12" />
                <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="◐" IsVisible="{Binding HasMask}" Foreground="#AAAAAA" FontSize="11" ToolTip.Tip="Has a mask" />
              </StackPanel>
              <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="#9A9A9A" />
            </StackPanel>
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
      <ListBox.ContextMenu>
        <ContextMenu>
          <MenuItem Header="Rename…" Click="RenameClicked" />
          <MenuItem Header="Duplicate Layer" Command="{Binding DuplicateLayer}" />
          <MenuItem Header="Delete Layer" Command="{Binding DeleteLayer}" />
          <MenuItem Header="Move Layer Up" Command="{Binding MoveLayerUp}" />
          <MenuItem Header="Move Layer Down" Command="{Binding MoveLayerDown}" />
          <Separator />
          <MenuItem Header="Group Layers" Command="{Binding GroupLayers}" />
          <MenuItem Header="Create / Release Clipping Mask" Command="{Binding ToggleClipping}" />
          <Separator />
          <MenuItem Header="Add Layer Mask" Command="{Binding AddMask}" />
          <MenuItem Header="Enable / Disable Mask" Command="{Binding ToggleMask}" />
          <MenuItem Header="Delete Mask" Command="{Binding DeleteMask}" />
        </ContextMenu>
      </ListBox.ContextMenu>
    </ListBox>
  </DockPanel>
</UserControl>
