<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Compositor.App.Dialogs.NewCanvasWindow"
        Title="New Canvas" Width="320" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <StackPanel Margin="16" Spacing="10">
    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" >
      <TextBlock Grid.Row="0" Grid.Column="0" Text="Width" VerticalAlignment="Center" Margin="0,0,12,6" />
      <NumericUpDown Grid.Row="0" Grid.Column="1" x:Name="WidthBox" Minimum="1" Maximum="30000" Increment="1" FormatString="0" Value="1920" Margin="0,0,0,6" />
      <TextBlock Grid.Row="1" Grid.Column="0" Text="Height" VerticalAlignment="Center" Margin="0,0,12,0" />
      <NumericUpDown Grid.Row="1" Grid.Column="1" x:Name="HeightBox" Minimum="1" Maximum="30000" Increment="1" FormatString="0" Value="1080" />
    </Grid>
    <TextBlock Text="Pixels, up to 30,000 per side." Foreground="#9A9A9A" FontSize="12" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="Cancel" Click="Cancel" IsCancel="True" />
      <Button Content="Create" Click="Create" IsDefault="True" />
    </StackPanel>
  </StackPanel>
</Window>
