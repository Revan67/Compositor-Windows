<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Missing XML comments on public members: useful later, noise while scaffolding. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      Avalonia renders through Skia. Core must use the exact SkiaSharp version Avalonia pins,
      or the canvas lease hands Core an SKCanvas from a different assembly. Verify with
      `dotnet list package -include-transitive` after bumping Avalonia.
    -->
    <AvaloniaVersion>12.1.2</AvaloniaVersion>
    <!-- Read from `dotnet list package -include-transitive` on Compositor.App. -->
    <SkiaSharpVersion>3.119.4</SkiaSharpVersion>
  </PropertyGroup>

</Project>
